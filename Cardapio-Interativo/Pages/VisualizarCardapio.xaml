<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cardapio_Interativo.Pages.VisualizarCardapio"
             Title="VisualizarCardapio">
    <Grid RowDefinitions="50,Auto">

        <Label Text="{Binding Restaurante}" Grid.Row="0"/>
        <CollectionView x:Name="listaCardapio" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border>
                    <VerticalStackLayout>
                        <Image Source="{Binding Foto}"/>
                        <Label Text="{Binding Nome}"/>
                        <Label Text="{Binding Descricao}"/>
                        <Label Text="{Binding Valor}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Nenhum item foi encontrado no cardápio"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>