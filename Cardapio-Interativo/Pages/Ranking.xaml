<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cardapio_Interativo.Pages.Ranking"
             Title="Ranking">
    <Grid VerticalOptions="Center">
        <CollectionView x:Name="listaRanking">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border WidthRequest="600" HeightRequest="200" StrokeShape="RoundRectangle 10" Margin="0,30,0,0">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nome}"/>
                            <Image Source="{Binding Foto}"/>
                            <Label Text="{Binding Curtidas}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Nenhum item encontrado"/>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>